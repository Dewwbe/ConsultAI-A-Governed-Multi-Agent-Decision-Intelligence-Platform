{
 "openapi": "3.1.0",
 "info": {
  "title": "ConsultAI",
  "version": "0.3.0"
 },
 "paths": {
  "/me": {
   "get": {
    "summary": "Me",
    "operationId": "getMe",
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Me"
        }
       }
      }
     },
     "401": {
      "description": "missing or invalid credentials"
     }
    }
   }
  },
  "/engagements": {
   "post": {
    "summary": "Create Engagement",
    "description": "wait=false returns immediately with status `running`; follow progress via /events.",
    "operationId": "createEngagement",
    "parameters": [
     {
      "name": "wait",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "default": true,
       "title": "Wait"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/EngagementRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EngagementDetail"
        }
       }
      }
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   },
   "get": {
    "summary": "List Engagements",
    "operationId": "listEngagements",
    "parameters": [
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "enum": [
          "running",
          "awaiting_approval",
          "completed",
          "rejected",
          "escalated",
          "failed"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Status"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 200,
       "minimum": 1,
       "default": 50,
       "title": "Limit"
      }
     },
     {
      "name": "offset",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "Offset"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EngagementList"
        }
       }
      }
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/engagements/{workflow_id}": {
   "get": {
    "summary": "Get Engagement",
    "operationId": "getEngagement",
    "parameters": [
     {
      "name": "workflow_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Workflow Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EngagementDetail"
        }
       }
      }
     },
     "404": {
      "description": "engagement not found"
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/engagements/{workflow_id}/approval": {
   "post": {
    "summary": "Approve",
    "operationId": "submitApproval",
    "parameters": [
     {
      "name": "workflow_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Workflow Id"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ApprovalRequest"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/EngagementDetail"
        }
       }
      }
     },
     "404": {
      "description": "engagement not found"
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "403": {
      "description": "caller lacks the approver role"
     },
     "409": {
      "description": "engagement is not awaiting approval"
     },
     "422": {
      "description": "invalid decision, reason or changes"
     }
    }
   }
  },
  "/engagements/{workflow_id}/approvals": {
   "get": {
    "summary": "Approvals",
    "operationId": "listApprovals",
    "parameters": [
     {
      "name": "workflow_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Workflow Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/ApprovalRecord"
         },
         "title": "Response Listapprovals"
        }
       }
      }
     },
     "404": {
      "description": "engagement not found"
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/engagements/{workflow_id}/guardian": {
   "get": {
    "summary": "Guardian Log",
    "operationId": "getGuardianLog",
    "parameters": [
     {
      "name": "workflow_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Workflow Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/GuardianDecision"
         },
         "title": "Response Getguardianlog"
        }
       }
      }
     },
     "404": {
      "description": "engagement not found"
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/engagements/{workflow_id}/events": {
   "get": {
    "summary": "Stream Events",
    "description": "Live progress as Server-Sent Events: run_started, step_started/step_finished (agent,\nevaluator, guardian), then one of approval_requested | run_completed | run_escalated |\nrun_failed, after which the stream closes. Resume with `?after=<id>` or Last-Event-ID, e.g.\nto pick up approval_decided and the final events after submitting an approval.",
    "operationId": "streamEvents",
    "parameters": [
     {
      "name": "workflow_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string",
       "title": "Workflow Id"
      }
     },
     {
      "name": "after",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 0,
       "default": 0,
       "title": "After"
      }
     },
     {
      "name": "Last-Event-ID",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "title": "Last-Event-Id"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Server-Sent Events",
      "content": {
       "application/json": {
        "schema": {}
       },
       "text/event-stream": {}
      }
     },
     "404": {
      "description": "engagement not found"
     },
     "401": {
      "description": "missing or invalid credentials"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
  "/engagements/{workflow_id}/evidence": {
   "get": {
    "summary": "Evidence",
    "operationId": "getEvidence",
