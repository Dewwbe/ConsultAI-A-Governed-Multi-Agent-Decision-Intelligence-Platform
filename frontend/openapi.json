 },
 "components": {
  "schemas": {
   "AnalysisResult": {
    "properties": {
     "query": {
      "type": "string",
      "title": "Query"
     },
     "rows": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "type": "array",
      "title": "Rows"
     },
     "purpose": {
      "type": "string",
      "title": "Purpose"
     }
    },
    "type": "object",
    "required": [
     "query",
     "rows"
    ],
    "title": "AnalysisResult"
   },
   "ApprovalFeedback": {
    "properties": {
     "decision": {
      "type": "string",
      "title": "Decision"
     },
     "changes": {
      "additionalProperties": true,
      "type": "object",
      "title": "Changes"
     },
     "reason": {
      "type": "string",
      "title": "Reason"
     }
    },
    "type": "object",
    "required": [
     "decision",
     "changes",
     "reason"
    ],
    "title": "ApprovalFeedback"
   },
   "ApprovalRecord": {
    "properties": {
     "decided_at": {
      "type": "string",
      "title": "Decided At"
     },
     "approver_id": {
      "type": "string",
      "title": "Approver Id"
     },
     "approver_name": {
      "type": "string",
      "title": "Approver Name"
     },
     "approver_roles": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Approver Roles"
     },
     "decision": {
      "type": "string",
      "enum": [
       "approve",
       "modify",
       "reject"
      ],
      "title": "Decision"
     },
     "reason": {
      "type": "string",
      "title": "Reason"
     },
     "changes": {
      "additionalProperties": true,
      "type": "object",
      "title": "Changes"
     },
     "resulting_status": {
      "type": "string",
      "title": "Resulting Status"
     }
    },
    "type": "object",
    "required": [
     "decided_at",
     "approver_id",
     "approver_name",
     "approver_roles",
     "decision",
     "reason",
     "changes",
     "resulting_status"
    ],
    "title": "ApprovalRecord"
   },
   "ApprovalRequest": {
    "properties": {
     "decision": {
      "type": "string",
      "enum": [
       "approve",
       "modify",
       "reject"
      ],
      "title": "Decision"
     },
     "changes": {
      "additionalProperties": true,
      "type": "object",
      "title": "Changes",
      "description": "modify only: rationale, assumptions"
     },
     "reason": {
      "type": "string",
      "maxLength": 4000,
      "title": "Reason",
      "description": "required for modify and reject",
      "default": ""
     }
    },
    "type": "object",
    "required": [
     "decision"
    ],
    "title": "ApprovalRequest"
   },
   "BudgetUsage": {
    "properties": {
     "tokens": {
      "type": "integer",
      "title": "Tokens"
     },
     "cost_usd": {
      "type": "number",
      "title": "Cost Usd"
     },
     "tool_calls": {
      "type": "integer",
      "title": "Tool Calls"
     }
    },
    "type": "object",
    "required": [
     "tokens",
     "cost_usd",
     "tool_calls"
    ],
    "title": "BudgetUsage"
   },
   "EngagementDetail": {
    "properties": {
     "workflow_id": {
      "type": "string",
      "title": "Workflow Id"
     },
     "status": {
      "type": "string",
      "enum": [
       "running",
       "awaiting_approval",
       "completed",
       "rejected",
       "escalated",
       "failed"
      ],
      "title": "Status"
     },
     "pending_node": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Pending Node"
     },
     "halted_reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Halted Reason"
     },
     "error": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Error"
     },
     "state": {
      "$ref": "#/components/schemas/EngagementState"
     },
     "guardian_decisions": {
      "items": {
       "$ref": "#/components/schemas/GuardianDecision"
      },
      "type": "array",
      "title": "Guardian Decisions"
     },
     "metrics": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": "object",
      "title": "Metrics"
     },
     "budget": {
      "$ref": "#/components/schemas/BudgetUsage"
     }
    },
    "type": "object",
    "required": [
     "workflow_id",
     "status",
     "pending_node",
     "state",
     "guardian_decisions",
     "metrics",
     "budget"
    ],
    "title": "EngagementDetail"
   },
   "EngagementList": {
    "properties": {
     "items": {
      "items": {
       "$ref": "#/components/schemas/EngagementSummary"
      },
      "type": "array",
      "title": "Items"
     },
     "total": {
      "type": "integer",
      "title": "Total"
     },
     "limit": {
      "type": "integer",
      "title": "Limit"
     },
     "offset": {
      "type": "integer",
      "title": "Offset"
     }
    },
    "type": "object",
    "required": [
     "items",
     "total",
     "limit",
     "offset"
    ],
    "title": "EngagementList"
   },
   "EngagementRequest": {
    "properties": {
     "business_problem": {
      "type": "string",
      "maxLength": 4000,
      "minLength": 5,
      "title": "Business Problem"
     },
     "industry": {
      "type": "string",
      "maxLength": 200,
      "title": "Industry",
      "default": ""
     },
     "objectives": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 20,
      "title": "Objectives"
     },
     "constraints": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "maxItems": 20,
      "title": "Constraints"
     },
     "data_classification": {
      "type": "string",
      "enum": [
       "confidential",
       "internal",
       "public"
      ],
      "title": "Data Classification",
      "default": "confidential"
     }
    },
    "type": "object",
    "required": [
     "business_problem"
    ],
    "title": "EngagementRequest"
   },
   "EngagementSpec": {
    "properties": {
     "business_objective": {
      "type": "string",
      "title": "Business Objective"
     },
     "decision_question": {
      "type": "string",
      "title": "Decision Question"
     },
     "success_metrics": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Success Metrics"
     },
     "constraints": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Constraints"
     },
     "required_analysis": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Required Analysis"
     },
     "required_data": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Required Data"
     },
     "required_agents": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Required Agents"
     }
    },
    "type": "object",
    "required": [
     "business_objective",
     "decision_question",
     "success_metrics",
     "constraints",
     "required_analysis",
     "required_data",
     "required_agents"
    ],
    "title": "EngagementSpec"
   },
   "EngagementState": {
    "properties": {
     "conversation_id": {
      "type": "string",
      "title": "Conversation Id"
     },
     "workflow_id": {
      "type": "string",
      "title": "Workflow Id"
     },
     "engagement_id": {
      "type": "string",
      "title": "Engagement Id"
     },
     "user_id": {
      "type": "string",
      "title": "User Id"
     },
     "preferences": {
      "additionalProperties": true,
      "type": "object",
      "title": "Preferences"
     },
     "data_classification": {
      "type": "string",
      "title": "Data Classification"
     },
     "business_problem": {
      "type": "string",
      "title": "Business Problem"
     },
     "industry": {
      "type": "string",
      "title": "Industry"
     },
     "objectives": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Objectives"
     },
     "constraints": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Constraints"
     },
     "engagement_spec": {
      "$ref": "#/components/schemas/EngagementSpec"
     },
     "questions": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Questions"
     },
     "required_data": {
      "items": {
