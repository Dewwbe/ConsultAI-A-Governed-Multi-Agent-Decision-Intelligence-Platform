# Base URL of the ConsultAI API (the backend allows http://localhost:5173 via CORS_ORIGINS)
VITE_API_BASE_URL=http://localhost:8000
# dev: pick an identity in the UI (backend must run with AUTH_MODE=dev) | entra: Microsoft sign-in
VITE_AUTH_MODE=dev

# Needed only when VITE_AUTH_MODE=entra (the backend needs ENTRA_TENANT_ID / ENTRA_CLIENT_ID too)
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# optional; defaults to api://<client-id>/access_as_user
VITE_ENTRA_API_SCOPE=
