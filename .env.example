# --- Mode ---
LLM_PROVIDER=stub            # stub | azure_openai
ENVIRONMENT=dev

# --- Azure OpenAI / Foundry ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=       # leave empty to use Microsoft Entra ID (DefaultAzureCredential)
LLM_TIMEOUT_SEC=30
# Azure *deployment names* for each router tier
MODEL_SMALL=
MODEL_MEDIUM=
MODEL_REASONING=

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Data layer ---
# sqlite for local dev; postgresql://user:pw@host:5432/db in production (docker compose sets this)
DATABASE_URL=sqlite:///./consultai.db
COSMOS_ENDPOINT=
COSMOS_DATABASE=consultai
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=market-research
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=

# --- Governance defaults ---
POLICY_FILE=../policies/policy.yaml
MAX_TOKENS=100000
MAX_COST_USD=2.0
MAX_DURATION_SEC=300
MAX_TOOL_CALLS=100
APPROVAL_RISK_THRESHOLD=0.7

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
MLFLOW_TRACKING_URI=

# --- Authentication ---
AUTH_MODE=dev                # dev (trusts X-Dev-User/X-Dev-Roles; only allowed when ENVIRONMENT=dev) | entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=             # the API's application (client) ID: the expected token audience
APPROVER_ROLE=Partner        # app role required to approve / modify / reject

# --- Secrets and capacity ---
KEY_VAULT_URL=               # when set, any setting written as keyvault:<secret-name> is read from Key Vault at start-up
# MAX_CONCURRENT_RUNS=      # overrides limits.engagements.max_concurrent in policy.yaml
# MAX_QUEUED_RUNS=          # overrides policy; beyond this POST /engagements answers 429 with Retry-After

# --- Knowledge, data and memory backends (defaults are offline stand-ins) ---
RETRIEVER=local              # local | azure_search
AZURE_SEARCH_ENDPOINT=       # https://<service>.search.windows.net
AZURE_SEARCH_INDEX=consultai-chunks
AZURE_SEARCH_API_KEY=        # empty -> Microsoft Entra ID (az login / managed identity)
EMBEDDING_DEPLOYMENT=        # Azure OpenAI embedding deployment, e.g. text-embedding-3-small
EMBEDDING_DIMENSIONS=0       # 0 = the model default
ADLS_ACCOUNT_URL=            # https://<account>.blob.core.windows.net (the .dfs address also works)
ADLS_CONTAINER=
ADLS_PREFIX=
DATA_SOURCE=sqlite           # sqlite | databricks
DATABRICKS_CATALOG=main
DATABRICKS_TOKEN=            # empty -> Microsoft Entra ID
MEMORY_STORE=memory          # memory | cosmos
COSMOS_ENDPOINT=
COSMOS_KEY=                  # empty -> Microsoft Entra ID
COSMOS_DATABASE=consultai
COSMOS_CONTAINER=memory
