# --- Mode ---
LLM_PROVIDER=stub            # stub | azure_openai
ENVIRONMENT=dev

# --- Azure OpenAI / Foundry ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=       # leave empty to use Microsoft Entra ID (DefaultAzureCredential)
LLM_TIMEOUT_SEC=30
# Azure *deployment names* for each router tier
MODEL_SMALL=
MODEL_MEDIUM=
MODEL_REASONING=

# --- API ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Data layer ---
POSTGRES_DSN=postgresql://consultai:consultai@postgres:5432/consultai
COSMOS_ENDPOINT=
COSMOS_DATABASE=consultai
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=market-research
DATABRICKS_HOST=
DATABRICKS_HTTP_PATH=

# --- Governance defaults ---
POLICY_FILE=../policies/policy.yaml
MAX_TOKENS=100000
MAX_COST_USD=2.0
MAX_DURATION_SEC=300
MAX_TOOL_CALLS=100
APPROVAL_RISK_THRESHOLD=0.7

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
MLFLOW_TRACKING_URI=
